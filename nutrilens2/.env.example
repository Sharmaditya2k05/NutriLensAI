# NutriLens AI — Environment Variables
# Copy this file to .env and fill in your Gemini key

# ── Gemini API (FREE) ───────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/min, 1,500 requests/day — more than enough
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Model to use. gemini-2.0-flash was retired on 1 June 2026.
# If you hit free-tier quota limits, try gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the main model is busy, rate-limited or retired
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# ── Optional: USDA FoodData Central ─────────────────────────────────────────
# Free key from https://fdc.nal.usda.gov/api-guide.html (or use DEMO_KEY)
USDA_API_KEY=DEMO_KEY

# ── Open Food Facts ──────────────────────────────────────────────────────────
# No key needed — just a user-agent string
OFF_USER_AGENT=NutriLensAI/1.0
